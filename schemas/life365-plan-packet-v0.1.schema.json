{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life365.local/schemas/plan-packet-v0.1.schema.json",
  "title": "LIFE365 Plan Packet v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packet_id",
    "scope_id",
    "revision",
    "created_at",
    "title",
    "summary",
    "changes"
  ],
  "properties": {
    "schema": {
      "const": "life365.plan/v0.1"
    },
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "scope_id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "prompts", "output_recipes"],
      "properties": {
        "items": {
          "$ref": "#/$defs/itemChanges"
        },
        "prompts": {
          "$ref": "#/$defs/promptChanges"
        },
        "output_recipes": {
          "$ref": "#/$defs/recipeChanges"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "itemChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upsert", "retire"],
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "retire": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "promptChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upsert", "retire"],
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/prompt"
          }
        },
        "retire": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "recipeChanges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upsert", "retire"],
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputRecipe"
          }
        },
        "retire": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "label",
        "state",
        "summary",
        "tags",
        "dashboard",
        "continuity"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "state": {
          "enum": ["active", "paused", "closed"]
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "uniqueItems": true
        },
        "dashboard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "order", "show_last_record_age"],
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            "show_last_record_age": {
              "type": "boolean"
            }
          }
        },
        "continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carry_forward", "quiet_after_days"],
          "properties": {
            "carry_forward": {
              "type": "boolean"
            },
            "quiet_after_days": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3650
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_id",
        "label",
        "help_text",
        "field",
        "availability",
        "capture",
        "followups"
      ],
      "properties": {
        "prompt_id": {
          "$ref": "#/$defs/id"
        },
        "item_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "help_text": {
          "type": "string",
          "maxLength": 1000
        },
        "field": {
          "$ref": "#/$defs/field"
        },
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "capture": {
          "$ref": "#/$defs/capture"
        },
        "followups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/followup"
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "single_choice",
            "multi_choice",
            "boolean",
            "integer",
            "decimal",
            "scale",
            "short_text",
            "long_text",
            "duration_minutes",
            "time",
            "date"
          ]
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {
          "type": ["string", "number", "boolean"]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start_date", "end_date"],
      "properties": {
        "type": {
          "enum": ["manual", "once", "daily", "days_of_week"]
        },
        "local_time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "days": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "start_date": {
          "type": "string",
          "format": "date"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "allow_backfill",
        "recovery_days",
        "allow_unknown",
        "allow_not_applicable",
        "allow_defer"
      ],
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "allow_backfill": {
          "type": "boolean"
        },
        "recovery_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 365
        },
        "allow_unknown": {
          "type": "boolean"
        },
        "allow_not_applicable": {
          "type": "boolean"
        },
        "allow_defer": {
          "type": "boolean"
        }
      }
    },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "field"],
      "properties": {
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "equals"],
          "properties": {
            "field": {
              "const": "primary"
            },
            "equals": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "field": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label", "type", "optional"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "type": {
              "enum": [
                "single_choice",
                "multi_choice",
                "boolean",
                "integer",
                "decimal",
                "scale",
                "short_text",
                "long_text",
                "duration_minutes",
                "time",
                "date"
              ]
            },
            "optional": {
              "type": "boolean"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/option"
              }
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "outputRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipe_id", "title", "sections"],
      "properties": {
        "recipe_id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputSection"
          }
        }
      }
    },
    "outputSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "active_items",
            "recent_records",
            "quiet_items",
            "unresolved_opportunities",
            "evidence_coverage",
            "user_request"
          ]
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        }
      }
    }
  }
}
